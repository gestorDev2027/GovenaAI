# Copie este arquivo para .env e preencha. Em produção (Render), as mesmas variáveis vão no painel do Render
# (ver render.yaml).

# ── Modelo (Gemini) ──
GOOGLE_API_KEY=
AGENTE_MODELO=gemini-3.6-flash
# livre (padrão: o modelo decide quanto pensar) ou um teto fixo: minimal, low, medium, high
AGENTE_RACIOCINIO=livre
# Modelos extras que a Fábrica pode escolher por agente, separados por vírgula
# FABRICA_MODELOS=
# Preço do modelo em reais por milhão de tokens, para o custo na Visão geral
# PRECO_ENTRADA_REAIS_MILHAO=
# PRECO_SAIDA_REAIS_MILHAO=
AGENTOS_PORTA=7778

# ── Banco (Supabase do GestorGov) ──
# Sem DATABASE_URL, o servidor usa um SQLite local (dados/), bom para testar.
# Pooler em modo SESSÃO (porta 5432), com o papel gestorgov_app (migration supabase/gestorgov/):
# DATABASE_URL=postgresql://gestorgov_app.<id-do-projeto>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=gestorgov
# Storage dos documentos do Conhecimento (bucket privado "agentes")
# SUPABASE_URL=https://<id-do-projeto>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET_AGENTES=agentes

# ── Acesso ao painel ──
# Com OS_SECURITY_KEY, o painel exige login e a landing page oferece Cadastrar e Entrar (e-mail e senha);
# sem ela, o painel fica aberto e sem cadastro. Para testar o cadastro localmente, defina uma qualquer.
# OS_SECURITY_KEY=
# Login com Google (Client ID "Aplicativo da Web" do Google Cloud, com a origem do Render)
# PAINEL_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com
# Dono do painel (aprova os demais). Defina sempre: com o login aberto, sem ele ninguém vira dono.
# PAINEL_DONO=dev@gestorgov.com
# Opcional: só estes domínios (vazio = qualquer e-mail verificado, pendente até o dono aprovar)
# PAINEL_DOMINIOS=gestorgov.com
# Opcional: só estas pessoas
# PAINEL_EMAILS=
# PAINEL_SESSAO_HORAS=12

# ── Mapa da cidade (Mapbox) ──
# Token PÚBLICO (pk.) da conta Mapbox; restrinja ao domínio do painel em account.mapbox.com. Sem ele, a
# tela Cidade mostra só a lista das unidades.
# MAPBOX_TOKEN=pk.

# ── GestorGov ──
# CompanyOS: atividades de rotina dos setores como Rotinas do Agno (sim/nao)
GESTORGOV_COMPANYOS=nao
# Organização padrão quando a conversa não diz qual (o id dela); com uma só cadastrada, é ela
# GESTORGOV_ORGANIZACAO=
# Dados abertos do CNES (unidades de saúde no onboarding)
# CNES_API_URL=https://apidadosabertos.saude.gov.br/cnes/estabelecimentos
# Minutos sem mensagem até encerrar a conversa (padrão 480 = 8 h)
# INATIVIDADE_MINUTOS=480

# ── Manutenção ──
# AGENTE_PENSAMENTOS=sim
# Roteiro: inteiro (padrão) ou busca (só as seções parecidas com a mensagem)
# ROTEIRO_MODO=inteiro
